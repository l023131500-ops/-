# portal (מערכת 33) — משתני build.
# העתיקו ל-portal/.env.local ומלאו. שני אלה הם anon/publishable בלבד — הם
# נכנסים לבאנדל הציבורי במכוון ואינם סודות. סודות אמיתיים (מפתח ה-AI) יושבים
# רק ב-env של פרויקט Vercel ונקראים בפונקציה api/spec-analyze.ts.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# ── env של פרויקט Vercel (לא כאן, ולא בגיט) ────────────────────────────────
# SUPABASE_URL, SUPABASE_ANON_KEY  — לפונקציית הניתוח
# ANTHROPIC_API_KEY                — מפתח ה-AI (סוד)
# AI_MODEL                         — ברירת מחדל claude-opus-5
