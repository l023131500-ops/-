# more30 — environment variable NAMES only. NEVER put real secret values here.
# Real values live in each deployment's secret store (Railway / Vercel / Supabase),
# NOT in git. This file documents which names each surface expects.
#
# ── Shared Supabase (single project for the whole account) ──
# Public (safe to expose to the browser):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only (NEVER expose to the browser, NEVER commit):
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
#
# ── core registry schema (admin + portal read from here) ──
# Uses the same Supabase project; schema name = core
CORE_SCHEMA=core
#
# ── Billing: Nedarim Plus (Mosad 7016674) ──
# Server-only:
NEDARIM_MOSAD_ID=
NEDARIM_API_KEY=
NEDARIM_WEBHOOK_SECRET=
#
# ── App routing (packages/config) ──
BASE_PATH=
#
# ── 34 kesef — budget transparency (schema `kesef` on the hub project) ──
# The app is NOT yet located (see NEEDS_USER); these are the names it must use
# when it arrives, so that nothing of its lands in `public` or in another app's
# namespace. Public (browser):
NEXT_PUBLIC_KESEF_SUPABASE_URL=
NEXT_PUBLIC_KESEF_SUPABASE_ANON_KEY=
# 'staging' shows the permanent "test data" banner and blocks indexing;
# only 'production' removes the banner and opens robots.txt.
NEXT_PUBLIC_KESEF_ENV=
# Server-only:
KESEF_SUPABASE_SERVICE_ROLE_KEY=
KESEF_DB_SCHEMA=kesef
#
# ── 35 kiosk — KioskFleet (Railway service, NOT Vercel) ──
# Set in Railway → project kioskfleet → Variables. Never in git.
# Path prefix the server mounts itself under; the portal proxies
# more30.com/kiosk/* to it. Empty = served at the root (local dev).
KIOSK_BASE_PATH=/kiosk
# Where SQLite lives. MUST point inside the mounted Railway Volume, or every
# deploy starts from an empty database.
KIOSK_DB_PATH=/app/data/kioskfleet.db
# 'production' opens indexing; anything else serves a Disallow robots.txt.
KIOSK_ENV=
# Server-only:
KIOSK_JWT_SECRET=
KIOSK_SEED_ADMIN_USER=
KIOSK_SEED_ADMIN_PASSWORD=
