# more30 — environment variable NAMES only. NEVER put real secret values here.
# Real values live in each deployment's secret store (Railway / Vercel / Supabase),
# NOT in git. This file documents which names each surface expects.
#
# ── Shared Supabase (single project for the whole account) ──
# Public (safe to expose to the browser):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only (NEVER expose to the browser, NEVER commit):
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
#
# ── core registry schema (admin + portal read from here) ──
# Uses the same Supabase project; schema name = core
CORE_SCHEMA=core
#
# ── Billing: Nedarim Plus (Mosad 7016674) ──
# Server-only:
NEDARIM_MOSAD_ID=
NEDARIM_API_KEY=
NEDARIM_WEBHOOK_SECRET=
#
# ── App routing (packages/config) ──
BASE_PATH=
