# Chatzor Connect — environment variable NAMES only (no real values in git).
# Copy to .env.local and fill from the deployment secret store.

# Supabase (shared hub project uhnrgujbdxhhmoxcjria). The app uses the `chatzor` schema.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Postgres schema this app reads/writes (separate from the live `public` schema).
VITE_SUPABASE_SCHEMA=chatzor

# Optional: base path when served under the monorepo convention (app #16 → /16/).
# BASE_PATH=/16
