# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# secrets — NEVER commit real values (see CONNECTIONS.md)
.env
.env.local
.env.*.local
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
service-account*.json

# ── Vendored private source (Phase 1 import) ────────────────────────────────
# This monorepo repo is PUBLIC; the source systems are PRIVATE and hold secrets.
# The full code was imported LOCALLY for mapping/continuity, but must NOT be
# committed here. Only manifests (app.json) + STATUS are tracked. Vendoring the
# actual code awaits the hosting decision (make repo private / git submodules).
# See CONNECTIONS.md → "Hosting decision".
/apps/**
!/apps/
!/apps/README.md
!/apps/*/
!/apps/*/app.json
!/apps/*/STATUS.md
# belt-and-suspenders: never leak any vendored env file (incl. .env.example)
/apps/**/.env*

# ── Deploy staging ──────────────────────────────────────────────────────────
# _deploy/<project>/ holds per-system build output prepared for Vercel: compiled
# bundles, copied client dists, and .vercel/project.json link files. All of it is
# reproducible from the sources in apps/, and some of it embeds build-time env —
# so it stays local, exactly like apps/.
/_deploy/**

# logs / os
*.log
.DS_Store
coverage/

# ── Tool scratch output ─────────────────────────────────────────────────────
# Playwright MCP writes a page snapshot per verification run, and the nadlan
# work leaves API response dumps and print captures behind. They are evidence
# for one session, not part of the tree.
.playwright-mcp/
sv4-body.json
deck-print-full.png