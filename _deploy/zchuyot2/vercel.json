{
  "framework": null,
  "buildCommand": "echo no-build",
  "outputDirectory": "public",
  "functions": {
    "api/agent.ts": { "maxDuration": 120 }
  },
  "headers": [
    {
      "source": "/zchuyot/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/zchuyot/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/zchuyot/api/agent", "destination": "/api/agent" },
    { "source": "/zchuyot", "destination": "/zchuyot/index.html" },
    { "source": "/zchuyot/", "destination": "/zchuyot/index.html" },
    { "source": "/zchuyot/(.*)", "destination": "/zchuyot/index.html" }
  ]
}
